---
import BrandMark from './BrandMark.astro';

const navLinks = [
  { href: '#celebraciones', label: 'Celebraciones' },
  { href: '#espacio', label: 'El espacio' },
  { href: '#resenas', label: 'Reseñas' },
  { href: '#preguntas', label: 'Preguntas' },
];
---

<header id="site-header" class="site-header">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-6 px-4 sm:px-6 lg:px-8">
    <a
      href="#inicio"
      class="rounded-lg focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-brand"
      aria-label="Espai Aiyana, volver al inicio"
    >
      <BrandMark />
    </a>

    <nav aria-label="Navegación principal" class="hidden md:flex items-center gap-7">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="type-sm font-medium whitespace-nowrap opacity-90 hover:opacity-100 transition-opacity duration-200 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-brand rounded-md"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#reserva"
        class="inline-flex items-center justify-center rounded-full bg-emerald-brand px-5 py-2.5 type-sm font-semibold text-porcelain border border-porcelain/25 whitespace-nowrap hover:bg-emerald-deep active:-translate-y-[1px] active:scale-[0.98] transition-[background-color,transform] duration-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-porcelain"
      >
        Consultar fecha
      </a>
    </nav>

    <button
      id="mobile-menu-toggle"
      type="button"
      class="md:hidden inline-flex h-11 w-11 items-center justify-center rounded-full border border-current/25 transition-[background-color,transform] duration-200 active:scale-[0.98]"
      aria-expanded="false"
      aria-controls="mobile-nav"
      aria-label="Abrir menú de navegación"
    >
      <svg
        id="menu-icon-open"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
      >
        <path d="M4 7h16M4 12h16M4 17h16" />
      </svg>
      <svg
        id="menu-icon-close"
        aria-hidden="true"
        viewBox="0 0 24 24"
        class="hidden h-5 w-5"
        fill="none"
        stroke="currentColor"
        stroke-width="1.75"
        stroke-linecap="round"
      >
        <path d="M6 6l12 12M18 6l-12 12" />
      </svg>
    </button>
  </div>

  <nav
    id="mobile-nav"
    aria-label="Navegación móvil"
    hidden
    class="md:hidden border-t border-hairline bg-porcelain text-ink px-4 pb-6 pt-4 mt-3"
  >
    <div class="flex flex-col gap-2">
      {
        navLinks.map((link) => (
          <a
            href={link.href}
            class="rounded-xl px-3 py-3 type-body font-medium text-ink hover:bg-mist transition-colors duration-150"
          >
            {link.label}
          </a>
        ))
      }
      <a
        href="#reserva"
        class="mt-2 inline-flex items-center justify-center rounded-full bg-emerald-brand px-5 py-3.5 font-display text-[1.0625rem] font-semibold text-porcelain hover:bg-emerald-deep active:scale-[0.98] transition-[background-color,transform] duration-200"
      >
        Consultar disponibilidad
      </a>
    </div>
  </nav>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobileNav = document.getElementById('mobile-nav');
  const openIcon = document.getElementById('menu-icon-open');
  const closeIcon = document.getElementById('menu-icon-close');

  const supportsScrollTimeline =
    CSS.supports('(animation-timeline: scroll()) and (animation-range: 0% 100%)') &&
    window.matchMedia('(prefers-reduced-motion: no-preference)').matches;

  let menuOpen = false;

  const syncHeaderState = () => {
    if (!header) return;
    if (!supportsScrollTimeline || menuOpen) {
      header.classList.toggle('is-scrolled', menuOpen || window.scrollY > 40);
    } else {
      header.classList.remove('is-scrolled');
    }
  };

  if (!supportsScrollTimeline) {
    window.addEventListener('scroll', syncHeaderState, { passive: true });
    syncHeaderState();
  }

  const setMenuOpen = (next: boolean) => {
    menuOpen = next;
    if (!toggleBtn || !mobileNav) return;
    toggleBtn.setAttribute('aria-expanded', String(next));
    toggleBtn.setAttribute('aria-label', next ? 'Cerrar menú de navegación' : 'Abrir menú de navegación');
    mobileNav.hidden = !next;
    openIcon?.classList.toggle('hidden', next);
    closeIcon?.classList.toggle('hidden', !next);
    syncHeaderState();
  };

  toggleBtn?.addEventListener('click', () => setMenuOpen(!menuOpen));

  mobileNav?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setMenuOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && menuOpen) {
      setMenuOpen(false);
      toggleBtn?.focus();
    }
  });
</script>
