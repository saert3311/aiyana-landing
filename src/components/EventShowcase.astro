---
import { Image } from 'astro:assets';
import { EVENT_TABS } from '../data/venue';
---

<section
  id="celebraciones"
  aria-labelledby="celebraciones-heading"
  class="py-20 sm:py-28 px-4 sm:px-6 lg:px-8 max-w-7xl mx-auto"
>
  <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
    <h2 id="celebraciones-heading" class="type-h2 text-ink max-w-[20ch]">
      Un espacio en blanco que se adapta a tu celebración
    </h2>
    <p class="type-body text-ink-muted max-w-[44ch]">
      Elige el formato de tu encuentro y descubre cómo transformamos la sala para cada ocasión.
    </p>
  </div>

  <div class="mt-10">
    <div
      role="tablist"
      aria-labelledby="celebraciones-heading"
      class="grid grid-cols-2 sm:inline-grid sm:grid-cols-4 gap-1.5 rounded-2xl bg-mist p-1.5 border border-hairline w-full lg:w-auto"
    >
      {
        EVENT_TABS.map((tab, index) => (
          <button
            type="button"
            role="tab"
            id={`tab-${tab.id}`}
            aria-selected={index === 0 ? 'true' : 'false'}
            aria-controls={`panel-${tab.id}`}
            tabindex={index === 0 ? 0 : -1}
            data-event-tab={tab.id}
            class:list={[
              'rounded-xl px-4 py-3 text-left sm:text-center type-sm font-medium transition-[background-color,color] duration-200 cursor-pointer focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-emerald-brand',
              index === 0
                ? 'bg-emerald-brand text-porcelain'
                : 'text-ink-muted hover:text-ink',
            ]}
          >
            {tab.label}
          </button>
        ))
      }
    </div>

    <div class="mt-8 sm:mt-10">
      {
        EVENT_TABS.map((tab, index) => (
          <div
            role="tabpanel"
            id={`panel-${tab.id}`}
            aria-labelledby={`tab-${tab.id}`}
            tabindex="0"
            hidden={index !== 0}
            class="grid grid-cols-1 md:grid-cols-[7fr_5fr] gap-8 lg:gap-12 items-center focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-emerald-brand rounded-3xl"
          >
            <div class="aspect-square max-h-[540px] w-full overflow-hidden rounded-3xl bg-mist">
              <Image
                src={tab.image}
                alt={tab.alt}
                widths={[640, 960, 1440]}
                sizes="(min-width: 768px) 56vw, 100vw"
                loading="lazy"
                fetchpriority={index === 0 ? undefined : 'low'}
                class={`h-full w-full object-cover ${tab.objectPosition}`}
              />
            </div>

            <div class="flex flex-col items-start">
              <h3 class="type-subhead text-ink">{tab.title}</h3>
              <p class="type-body text-ink-muted max-w-[65ch] mt-3">
                {tab.description}
              </p>

              <ul class="mt-6 space-y-3 border-t border-hairline pt-6 w-full">
                {tab.highlights.map((item) => (
                  <li class="flex items-start gap-3 type-body text-ink">
                    <svg
                      aria-hidden="true"
                      viewBox="0 0 20 20"
                      class="mt-1.5 h-4 w-4 shrink-0 text-emerald-brand"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M4.5 10.5l3.5 3.5 7.5-8" />
                    </svg>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>

              <a
                href="#reserva"
                data-select-event={tab.selectValue}
                class="mt-7 inline-flex items-center gap-2 font-display text-[1.0625rem] font-semibold text-emerald-brand hover:text-emerald-deep underline underline-offset-4 decoration-hairline hover:decoration-emerald-brand transition-colors duration-200"
              >
                <span>Consultar disponibilidad para este formato</span>
                <svg
                  aria-hidden="true"
                  viewBox="0 0 20 20"
                  class="h-4 w-4"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                >
                  <path d="M4.5 10h11m-4.5-4.5L15.5 10 11 14.5" />
                </svg>
              </a>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-event-tab]'));
  const panels = tabs
    .map((tab) => document.getElementById(tab.getAttribute('aria-controls') || ''))
    .filter((panel): panel is HTMLElement => panel !== null);

  const activateTab = (nextTab: HTMLButtonElement, moveFocus = false) => {
    const targetId = nextTab.getAttribute('aria-controls');

    tabs.forEach((tab) => {
      const active = tab === nextTab;
      tab.setAttribute('aria-selected', String(active));
      tab.tabIndex = active ? 0 : -1;
      tab.classList.toggle('bg-emerald-brand', active);
      tab.classList.toggle('text-porcelain', active);
      tab.classList.toggle('text-ink-muted', !active);
      tab.classList.toggle('hover:text-ink', !active);
    });

    panels.forEach((panel) => {
      panel.hidden = panel.id !== targetId;
    });

    if (moveFocus) {
      nextTab.focus();
    }
  };

  tabs.forEach((tab, index) => {
    tab.addEventListener('click', () => activateTab(tab));

    tab.addEventListener('keydown', (event) => {
      let nextIndex = -1;
      if (event.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
      else if (event.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
      else if (event.key === 'Home') nextIndex = 0;
      else if (event.key === 'End') nextIndex = tabs.length - 1;

      if (nextIndex !== -1) {
        event.preventDefault();
        activateTab(tabs[nextIndex], true);
      }
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-select-event]').forEach((link) => {
    link.addEventListener('click', () => {
      const value = link.dataset.selectEvent;
      if (!value) return;
      document.dispatchEvent(new CustomEvent('aiyana:select-event', { detail: value }));
    });
  });
</script>
